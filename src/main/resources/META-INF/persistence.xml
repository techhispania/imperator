<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
						https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
	version="3.2">

	<persistence-unit name="imperatorPU">

		<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

		<!-- Your entities -->
		<!-- You can explicitly list them; or use classpath scanning -->
		<class>com.techhispania.imperator.server.domain.model.Application</class>

		<properties>

			<!-- JDBC -->
			<property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC" />
			<property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:imperator.db" />

			<!-- Hibernate dialect -->
			<property name="hibernate.dialect" value="com.techhispania.imperator.server.infrastructure.db.SQLiteDialect" />

			<!-- Disable schema auto-generation because you use manual scripts -->
			<property name="hibernate.hbm2ddl.auto" value="none" />

			<!-- Optional, but recommended -->
			<property name="hibernate.show_sql" value="true" />
			<property name="hibernate.format_sql" value="true" />

			<!-- Ensure correct transaction handling for non-JTA apps (desktop) -->
			<property name="jakarta.persistence.transactionType" value="RESOURCE_LOCAL" />
			<property name="hibernate.connection.provider_disables_autocommit" value="true" />
			<property name="hibernate.current_session_context_class" value="thread" />

		</properties>
	</persistence-unit>

</persistence>
